{
  "version": 3,
  "configurePresets": [
    {
      "name": "arm",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake"
    },
    {
      "name": "debug",
      "displayName": "VCU firmware (Debug)",
      "inherits": "arm",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "VCU firmware (Release)",
      "inherits": "arm",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "nucleo",
      "displayName": "NUCLEO-F446RE bench build (Debug)",
      "inherits": "arm",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "VCU_BOARD": "nucleo" }
    },
    {
      "name": "host",
      "displayName": "Host unit tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "nucleo", "configurePreset": "nucleo" },
    { "name": "host", "configurePreset": "host" }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": { "outputOnFailure": true }
    }
  ]
}
