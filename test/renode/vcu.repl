// VCU (STM32F446RE) on top of Renode's generic STM32F4 platform.
// STM32F4_ADC_Patched.cs and STM32F4_DMA_Patched.cs have to be included first.

using "platforms/cpus/stm32f4.repl"

// F446RE sizes, so overflowing the real part shows up here too
sram:
    size: 0x20000

flash:
    size: 0x80000

// Clocks as clock_init() sets them up. Renode doesn't model the RCC tree, so
// each peripheral gets its input clock here.
nvic:
    systickFrequency: 180000000

// 180 MHz core, about one instruction per clock (default is 100)
cpu:
    PerformanceInMips: 180

timer5:
    frequency: 90000000

// APB1 is 45 MHz. The UART model paces received bytes at the baud rate it
// works out from BRR and this clock.
uart4:
    frequency: 45000000

// UART5_RX is request 4 on DMA1 stream 0 (stream * 8 + channel, see the DMA model)
uart5:
    frequency: 45000000
    DMARequest -> dma1p@4

// Renode's STM32DMA can't run a circular receive ring (no circular mode, half
// transfer or channel selection), so dma1 comes off the bus and the patched
// model takes its place
dma1: @ none

dma1p: DMA.STM32F4_DMA_Patched @ sysbus 0x40026000
    [0-7] -> nvic@[11-17,47]

// ADC common registers (CCR holds the ADC clock prescaler), SYSCFG (EXTICR for
// the RTD button) and DBGMCU (freeze bits). Not modelled by Renode, plain
// storage so tests can read back what the firmware wrote.
adc_common: Memory.ArrayMemory @ sysbus 0x40012300
    size: 0x100

syscfg: Memory.ArrayMemory @ sysbus 0x40013800
    size: 0x400

dbgmcu: Memory.ArrayMemory @ sysbus 0xE0042000
    size: 0x10

// One conversion is (56 + 12) cycles at 22.5 MHz = 3.02 us, like adc.c sets up
adc1: Analog.STM32F4_ADC_Patched @ sysbus 0x40012000
    conversionTimeNs: 3022
    IRQ -> nvic@18
